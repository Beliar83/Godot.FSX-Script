<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>FsxScriptServer</RootNamespace>
        <Authors>Beliar83(karstenbock@gmx.net)</Authors>
        <Copyright>Copyright Beliar83 2025</Copyright>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Version>0.9.0</Version>
        <DefineConstants>$(DefineConstants);FSX_SERVER_ACTIVE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="ScriptSession.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GodotSharp" Version="4.4.0"/>
        <PackageReference Include="FSharp.Compiler.Service" Version="43.9.201"/>
        <PackageReference Include="FSharpx.Collections" Version="3.1.0"/>
        <PackageReference Update="FSharp.Core" Version="9.0.201"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Godot.FsxScript\Godot.FsxScript.fsproj"/>
    </ItemGroup>

</Project>
