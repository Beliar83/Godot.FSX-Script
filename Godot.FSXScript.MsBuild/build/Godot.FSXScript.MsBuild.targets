<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <ItemGroup>
        <ScriptFiles Include="$(RootFolder)\*.fsx"/>
    </ItemGroup>

    <!--A target that generates code, which is executed before the compilation-->
    <Target Name="GenerateDotnetfiles" BeforeTargets="CoreCompile" Inputs="@(ScriptFiles)" Outputs="$(RootFolder)\$(GeneratedPath)\*.cs" Condition="'$(Configuration)'!='DEBUG'">
        <FsxToGodotSharp ScriptFiles="@(ScriptFiles)" GodotSharpPath="$(GodotSharpPath)" GeneratedPath="$(GeneratedPath)" Namespace="$(RootNamespace)" FSharpCompilerPath="$(FSharpCompilerPath)">
            <Output TaskParameter="GeneratedFiles" PropertyName="DotnetFiles"/>
        </FsxToGodotSharp>
        <ItemGroup>
            <Compile Remove="$(DotnetFiles)"/>
            <Compile Include="$(DotnetFiles)"/>
        </ItemGroup>
    </Target>
</Project>